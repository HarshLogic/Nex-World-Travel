# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string, or runs in high-availability memory mode if offline)
MONGODB_URI=mongodb://localhost:27017/nex_world_travel

# JWT Authentication
JWT_SECRET=nex_jwt_secret_super_secure_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS and reset/activation links)
CLIENT_URL=http://localhost:3000

# Initial Master Head Setup (for npm run setup:admin)
MASTER_HEAD_EMAIL=adityar@nexworldtravel.com
MASTER_HEAD_PASSWORD=Aditiya@1993
MASTER_HEAD_NAME=Aditya R

# Booking Notifications & Routing Emails
BOOKING_ASSISTANCE_EMAIL=reservation@nexworldtravel.com
BOOKING_BENEFITS_EMAIL=reservation@nexworldtravel.com
BUSINESS_BOOKING_EMAIL=reservation@nexworldtravel.com
CUSTOMER_CARE_EMAIL=customercare@nexworldtravel.com

# SMTP Transactional Email Configuration (optional: falls back to simulated logger)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@nexworldtravel.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=no-reply@nexworldtravel.com

# Cloudinary Media Storage (optional: falls back to resilient local /uploads disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
