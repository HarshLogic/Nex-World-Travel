{
  "name": "nex-world-travel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix client run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix client start",
    "start:client": "npm --prefix client start",
    "start:server": "npm --prefix server start",
    "setup:admin": "npm --prefix server run setup:admin",
    "kill:ports": "npx -y kill-port 3000 5000",
    "test": "node server/test/api.test.js",
    "install:all": "npm --prefix client install && npm --prefix server install"
  }
}
